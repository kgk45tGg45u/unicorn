# Copy to .env and fill in. Never commit .env.

# Django secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=mysql://unicorn:password@127.0.0.1:3306/unicorn
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
UNICORN_MASTER_KEY=
# HMAC key: python -c "import secrets; print(secrets.token_hex(32))"
UNICORN_HMAC_KEY=
# Optional note shown with backups
UNICORN_BACKUP_NOTE=
EMAIL_URL=consolemail://
SITE_URL=http://127.0.0.1:8000
# Where encrypted uploads are kept (outside the web root). Default: private_media/ in the project.
PRIVATE_MEDIA_ROOT=
