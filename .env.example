# Copy to .env and fill in. Never commit .env.

# Django secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=mysql://unicorn:password@127.0.0.1:3306/unicorn
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
UNICORN_MASTER_KEY=
# HMAC key: python -c "import secrets; print(secrets.token_hex(32))"
UNICORN_HMAC_KEY=
# Optional note shown with backups
UNICORN_BACKUP_NOTE=
EMAIL_URL=consolemail://
SITE_URL=http://127.0.0.1:8000
# The public address of the source code (the AGPL asks for it, HF-19). Empty: the footer points to the third-party page.
SOURCE_URL=
# Where encrypted uploads are kept (outside the web root). Default: private_media/ in the project.
PRIVATE_MEDIA_ROOT=
# The admin is not at admin/: choose a secret path of your own (letters and dashes). Staff need a passkey to open it.
ADMIN_PATH=
# HSTS: 3600 at first; 31536000 (one year) once the site has run for a week without problems.
SECURE_HSTS_SECONDS=3600
# Old master keys, only while a key rotation runs (docs/08 section 4)
UNICORN_OLD_MASTER_KEYS=
# Who gets the error emails (comma-separated), and the address they come from
ADMIN_EMAILS=
SERVER_EMAIL=unicorn@localhost
# The address login codes and notices come from
DEFAULT_FROM_EMAIL=no-reply@localhost
# Where people report a security problem (an email address; shown at /.well-known/security.txt)
SECURITY_CONTACT=
# Optional, production only: True makes /healthz also look at the file ~/run/last_backup (your own backup job
# may write the time into it, one line: date -u +%Y-%m-%dT%H:%M:%SZ > ~/run/last_backup)
BACKUP_EXPECTED=False
# Which list of Python libraries the release script installs: requirements.txt, or requirements-server.txt
# (PyMySQL instead of mysqlclient) on a box without the database development files.
REQUIREMENTS_FILE=requirements.txt
# On the server: where collectstatic puts the files Apache serves, e.g. /home/<user>/public_html/static
STATIC_ROOT=
# Staging only: the database the tests may create tables in (the test runner then uses it, P15.T04)
TEST_DATABASE_NAME=
